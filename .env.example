APP_NAME=DoliNews
APP_ENV=local
APP_KEY=
# Valeur sûre par défaut : un poste de développement passe à true
# localement, une mise en production ne devient jamais bavarde par oubli.
APP_DEBUG=false
APP_URL=http://localhost

# Interface multilingue dès le premier jour (SPEC D14) : base française,
# anglais en repli. Les traductions d'interface vivent dans lang/.
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# LOG_LEVEL se décide (voir INSTALL.md) : laissé à debug, un service
# journalise le contenu soumis et produit des gigaoctets de journaux.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=dolinews
# DB_USERNAME=dolinews
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# À poser à true partout où le site est servi en https : sans cette valeur
# le cookie de session part en clair sur le moindre accès HTTP résiduel.
SESSION_SECURE_COOKIE=false

# Durée de vie d'un jeton d'API, en minutes (un an par défaut). Jamais
# vide : un jeton sans terme est un identifiant que personne ne révoque.
SANCTUM_TOKEN_EXPIRATION=525600

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ne-pas-repondre@dolinews.example"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# DoliNews
# ---------------------------------------------------------------------------

# Poivre des empreintes d'adresses de commit : sha256(poivre || adresse).
# SECRET D'APPLICATION, hors base, JAMAIS en colonne. NE JAMAIS le changer
# ni le régénérer : le modifier invaliderait toutes les empreintes déjà
# calculées (SPEC 3.2). Générer une valeur longue et unique.
DOLINEWS_COMMITTER_PEPPER=

# Dépôts git de référence moissonnés pour la vérification des contributeurs
# (SPEC 3.2, D4) : chemins de clones locaux, séparés par des virgules.
# Aucune API de forge n'est jamais appelée.
DOLINEWS_REFERENCE_REPOS=

# Compte super administrateur posé par le seeder (mot de passe à changer
# dès la première connexion).
DOLINEWS_SUPER_ADMIN_EMAIL=admin@dolinews.invalid
DOLINEWS_SUPER_ADMIN_NAME="Super administrateur DoliNews"
DOLINEWS_SUPER_ADMIN_PASSWORD=

# Quorum de publication et bornes de la phase d'amorçage (SPEC 5.1).
DOLINEWS_REVIEW_QUORUM=3
# Une traduction tierce passe devant un seul relecteur ; celle que son
# propre éditeur dépose ne passe pas du tout par la revue (SPEC 5.1).
DOLINEWS_TRANSLATION_QUORUM=1
DOLINEWS_MODERATOR_FLOOR=6
DOLINEWS_BOOTSTRAP_CEILING=50
DOLINEWS_REVIEW_REMINDER_DAYS=3
DOLINEWS_REVIEW_MEDIAN_WINDOW=20

# Quotas de publication (SPEC 5.3, valeurs par défaut : SPEC 15 les laisse
# à l'observation du débit réel).
DOLINEWS_QUOTA_TOKEN_DAYS=7
DOLINEWS_QUOTA_BUCKET_CAPACITY=3
DOLINEWS_QUEUE_CEILING=5

# Signalement d'un contenu publié (SPEC 9.10) : signalements acceptés par
# heure et par origine. Le canal est ouvert sans compte, l'équipe n'est
# prévenue qu'au premier signalement ouvert d'une même cible.
DOLINEWS_REPORTS_PER_HOUR_IP=10

# Adresse publique où signaler une faille DU SERVICE lui-même, publiée
# en /.well-known/security.txt (RFC 9116). Sans adresse, le fichier est
# absent, ce qui est l'état honnête : un security.txt nommant une
# adresse que personne ne lit envoie le decouvreur dans le vide.
DOLINEWS_SECURITY_CONTACT=

# Traduction automatique (SPEC 5.7). Sans point d'accès, la
# fonctionnalité est simplement absente : le service ne publie alors que
# ce qu'écrivent les éditeurs et leurs traducteurs mandatés.
#
# Le point d'accès reçoit un tableau de textes et rend leurs traductions
# dans le même ordre ; le jeton l'authentifie. Plafond mensuel de
# caractères par éditeur sur cette voie partagée : au-delà, un éditeur
# renseigne sa propre clé DeepL et ne tire plus sur cette voie.
# DOLINEWS_TRANSLATION_LOCALES liste les langues que le moteur traite,
# vide valant toutes les langues de contenu.
DOLINEWS_TRANSLATION_ENDPOINT=
DOLINEWS_TRANSLATION_TOKEN=
DOLINEWS_TRANSLATION_TIMEOUT=20
DOLINEWS_TRANSLATION_MONTHLY_CHARS=120000
#DOLINEWS_TRANSLATION_LOCALES=en_US,es_ES,de_DE,it_IT,pt_PT,nl_NL,pl_PL,ro_RO,el_GR
DOLINEWS_TRANSLATION_LOCALES=

# Veille des versions du coeur Dolibarr (SPEC 5.8). Sans fiche projet ni
# compte de soumission, la veille est inactive : ce sont des actes
# éditoriaux, et une tâche planifiée n'en crée aucun. Elle soumet à la
# revue, elle ne publie jamais.
#
# DOLINEWS_RELEASES_PROJECT est le slug de la fiche du coeur,
# DOLINEWS_RELEASES_AUTHOR l'adresse du compte qui dépose. Le point
# d'accès de rédaction est facultatif : sans lui, l'annonce énonce les
# faits et renvoie à la note de version d'origine.
DOLINEWS_RELEASES_FEED=https://github.com/Dolibarr/dolibarr/releases.atom
DOLINEWS_RELEASES_TIMEOUT=20
DOLINEWS_RELEASES_PROJECT=
DOLINEWS_RELEASES_AUTHOR=
DOLINEWS_RELEASES_LOCALE=fr_FR
DOLINEWS_RELEASES_MAX_PER_RUN=3
DOLINEWS_RELEASES_SOURCE_CHARS=20000
DOLINEWS_RELEASES_WRITER_ENDPOINT=
DOLINEWS_RELEASES_WRITER_TOKEN=
DOLINEWS_RELEASES_WRITER_TIMEOUT=60

# Médias (SPEC 7) : taille maximale à l'entrée et plus long côté après
# ré-encodage.
DOLINEWS_MEDIA_MAX_BYTES=8388608
DOLINEWS_MEDIA_MAX_DIMENSION=1600
DOLINEWS_MEDIA_ORPHAN_HOURS=24

# Liens sortants (SPEC 8). Le contrôle périodique n'est autorisé à joindre
# qu'une adresse publique en http/https : voir OutboundUrlGuard.
DOLINEWS_LINK_CHECK_TIMEOUT=10
DOLINEWS_LINK_CHECK_MAX_BYTES=262144

# Flux génériques (SPEC 6.4) : cache borné et taille de page.
DOLINEWS_FEEDS_CACHE_SECONDS=300
DOLINEWS_FEEDS_PAGE_SIZE=50

# Longueur maximale d'une description de fiche projet, en caractères. Une fiche
# présente un projet, elle ne le documente pas : la documentation vit derrière
# le lien de type doc de la fiche. Sans borne, un manuel entier finit ici et
# repousse la première annonce hors de l'écran.
DOLINEWS_PROJECT_DESCRIPTION_MAX=8000

# Nombre maximal de captures dans la galerie d'une fiche. Même raison que la
# description : la fiche montre le module, la visite complète appartient à sa
# documentation ou à sa démonstration.
DOLINEWS_PROJECT_GALLERY_MAX=10

# Vérification de contribution : durée de validité du code (minutes), puis
# tentatives par heure. Démarrer le parcours envoie un courriel à une adresse
# de TIERS lue dans l'index public : l'endpoint est borné par compte et par
# origine.
DOLINEWS_VERIFY_CODE_TTL=60
DOLINEWS_VERIFY_ATTEMPTS_ACCOUNT=5
DOLINEWS_VERIFY_ATTEMPTS_IP=15

# ---------------------------------------------------------------------------
# Piège à scanners (capdoc:LARAVEL_HONEYPOT.md)
# ---------------------------------------------------------------------------

HONEYPOT_ENABLED=true
HONEYPOT_IP_WHITELIST=

# Frontal éventuel (vide = exposition directe). Lu par TrustProxies et par
# la garde du honeypot pour refuser de signaler le frontal lui-même.
TRUSTED_PROXIES=

# Report Fail2Band (derrière un frontal). Désactivé par défaut : sortie
# locale fail2ban en exposition directe.
HONEYPOT_FAIL2BAND_ENABLED=false
HONEYPOT_FAIL2BAND_URL=
HONEYPOT_FAIL2BAND_API_KEY=
HONEYPOT_FAIL2BAND_JAIL=dolinews-honeypot
HONEYPOT_FAIL2BAND_TIMEOUT=5

# ---------------------------------------------------------------------------
# Exploitation (caprel/laravel-ops, capdoc:LARAVEL_DOCTOR.md)
# ---------------------------------------------------------------------------

# Destinataire du rapport d'audit des dépendances (`ops:security-audit`,
# planifié à 06:00). À défaut, l'adresse d'expédition de l'application est
# utilisée. Sans destinataire du tout, la commande échoue au lieu de se
# taire : un rapport qui ne part nulle part est pire que pas de rapport.
OPS_SECURITY_EMAIL=

# Topologie de l'ordonnanceur : `cron` (entrée /etc/cron.d, la nôtre) ou
# `supervisor` (programme schedule:work). Une seule des deux, jamais les
# deux : chaque tâche planifiée s'exécuterait en double.
OPS_SCHEDULER=cron
