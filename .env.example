APP_NAME=DoliNews
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Interface multilingue des le premier jour (SPEC D14) : base francaise,
# anglais en repli. Les traductions d'interface vivent dans lang/.
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# LOG_LEVEL se decide (voir INSTALL.md) : laisse a debug, un service
# journalise le contenu soumis et produit des gigaoctets de journaux.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=dolinews
# DB_USERNAME=dolinews
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ne-pas-repondre@dolinews.example"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# DoliNews
# ---------------------------------------------------------------------------

# Poivre des empreintes d'adresses de commit : sha256(poivre || adresse).
# SECRET D'APPLICATION, hors base, JAMAIS en colonne. NE JAMAIS le changer
# ni le regenerer : le modifier invaliderait toutes les empreintes deja
# calculees (SPEC 3.2). Generer une valeur longue et unique.
DOLINEWS_COMMITTER_PEPPER=

# Depots git de reference moissonnes pour la verification des contributeurs
# (SPEC 3.2, D4) : chemins de clones locaux, separes par des virgules.
# Aucune API de forge n'est jamais appelee.
DOLINEWS_REFERENCE_REPOS=

# Compte super administrateur pose par le seeder (mot de passe a changer
# des la premiere connexion).
DOLINEWS_SUPER_ADMIN_EMAIL=admin@dolinews.invalid
DOLINEWS_SUPER_ADMIN_NAME="Super administrateur DoliNews"
DOLINEWS_SUPER_ADMIN_PASSWORD=

# Quorum de publication et bornes de la phase d'amorcage (SPEC 5.1).
DOLINEWS_REVIEW_QUORUM=3
DOLINEWS_MODERATOR_FLOOR=6
DOLINEWS_BOOTSTRAP_CEILING=10
DOLINEWS_REVIEW_REMINDER_DAYS=3
DOLINEWS_REVIEW_MEDIAN_WINDOW=20

# Quotas de publication (SPEC 5.3, valeurs par defaut : SPEC 15 les laisse
# a l'observation du debit reel).
DOLINEWS_QUOTA_TOKEN_DAYS=7
DOLINEWS_QUOTA_BUCKET_CAPACITY=3
DOLINEWS_QUEUE_CEILING=5

# Media (SPEC 7) : taille maximale a l'entree et plus long cote apres
# re-encodage.
DOLINEWS_MEDIA_MAX_BYTES=8388608
DOLINEWS_MEDIA_MAX_DIMENSION=1600
DOLINEWS_MEDIA_ORPHAN_HOURS=24

# Liens sortants (SPEC 8).
DOLINEWS_LINK_CHECK_TIMEOUT=10

# Flux generiques (SPEC 6.4) : cache borne et taille de page.
DOLINEWS_FEEDS_CACHE_SECONDS=300
DOLINEWS_FEEDS_PAGE_SIZE=50

# Verification de contribution : duree de validite du code (minutes).
DOLINEWS_VERIFY_CODE_TTL=60

# ---------------------------------------------------------------------------
# Piege a scanners (~/docs/laravel/LARAVEL_HONEYPOT.md)
# ---------------------------------------------------------------------------

HONEYPOT_ENABLED=true
HONEYPOT_IP_WHITELIST=

# Frontal eventuel (vide = exposition directe). Lu par TrustProxies et par
# la garde du honeypot pour refuser de signaler le frontal lui-meme.
TRUSTED_PROXIES=

# Report Fail2Band (derriere un frontal). Desactive par defaut : sortie
# locale fail2ban en exposition directe.
HONEYPOT_FAIL2BAND_ENABLED=false
HONEYPOT_FAIL2BAND_URL=
HONEYPOT_FAIL2BAND_API_KEY=
HONEYPOT_FAIL2BAND_JAIL=laravel-honeypot
HONEYPOT_FAIL2BAND_TIMEOUT=5
