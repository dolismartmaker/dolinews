APP_NAME=DoliNews
APP_ENV=local
APP_KEY=
# Valeur sure par defaut : un poste de developpement passe a true
# localement, une mise en production ne devient jamais bavarde par oubli.
APP_DEBUG=false
APP_URL=http://localhost

# Interface multilingue des le premier jour (SPEC D14) : base francaise,
# anglais en repli. Les traductions d'interface vivent dans lang/.
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# LOG_LEVEL se decide (voir INSTALL.md) : laisse a debug, un service
# journalise le contenu soumis et produit des gigaoctets de journaux.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=dolinews
# DB_USERNAME=dolinews
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# A poser a true partout ou le site est servi en https : sans cette valeur
# le cookie de session part en clair sur le moindre acces HTTP residuel.
SESSION_SECURE_COOKIE=false

# Duree de vie d'un jeton d'API, en minutes (un an par defaut). Jamais
# vide : un jeton sans terme est un identifiant que personne ne revoque.
SANCTUM_TOKEN_EXPIRATION=525600

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ne-pas-repondre@dolinews.example"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# DoliNews
# ---------------------------------------------------------------------------

# Poivre des empreintes d'adresses de commit : sha256(poivre || adresse).
# SECRET D'APPLICATION, hors base, JAMAIS en colonne. NE JAMAIS le changer
# ni le regenerer : le modifier invaliderait toutes les empreintes deja
# calculees (SPEC 3.2). Generer une valeur longue et unique.
DOLINEWS_COMMITTER_PEPPER=

# Depots git de reference moissonnes pour la verification des contributeurs
# (SPEC 3.2, D4) : chemins de clones locaux, separes par des virgules.
# Aucune API de forge n'est jamais appelee.
DOLINEWS_REFERENCE_REPOS=

# Compte super administrateur pose par le seeder (mot de passe a changer
# des la premiere connexion).
DOLINEWS_SUPER_ADMIN_EMAIL=admin@dolinews.invalid
DOLINEWS_SUPER_ADMIN_NAME="Super administrateur DoliNews"
DOLINEWS_SUPER_ADMIN_PASSWORD=

# Quorum de publication et bornes de la phase d'amorcage (SPEC 5.1).
DOLINEWS_REVIEW_QUORUM=3
# Une traduction tierce passe devant un seul relecteur ; celle que son
# propre editeur depose ne passe pas du tout par la revue (SPEC 5.1).
DOLINEWS_TRANSLATION_QUORUM=1
DOLINEWS_MODERATOR_FLOOR=6
DOLINEWS_BOOTSTRAP_CEILING=50
DOLINEWS_REVIEW_REMINDER_DAYS=3
DOLINEWS_REVIEW_MEDIAN_WINDOW=20

# Quotas de publication (SPEC 5.3, valeurs par defaut : SPEC 15 les laisse
# a l'observation du debit reel).
DOLINEWS_QUOTA_TOKEN_DAYS=7
DOLINEWS_QUOTA_BUCKET_CAPACITY=3
DOLINEWS_QUEUE_CEILING=5

# Traduction automatique (SPEC 5.7). Sans point d'acces, la
# fonctionnalite est simplement absente : le service ne publie alors que
# ce qu'ecrivent les editeurs et leurs traducteurs mandates. Le moteur
# vise une API compatible LibreTranslate, auto-hebergeable.
# DOLINEWS_TRANSLATION_LOCALES liste les langues que le moteur traite,
# vide valant toutes les langues de contenu.
DOLINEWS_TRANSLATION_ENDPOINT=
DOLINEWS_TRANSLATION_API_KEY=
DOLINEWS_TRANSLATION_TIMEOUT=20
DOLINEWS_TRANSLATION_LOCALES=

# Media (SPEC 7) : taille maximale a l'entree et plus long cote apres
# re-encodage.
DOLINEWS_MEDIA_MAX_BYTES=8388608
DOLINEWS_MEDIA_MAX_DIMENSION=1600
DOLINEWS_MEDIA_ORPHAN_HOURS=24

# Liens sortants (SPEC 8). Le controle periodique n'est autorise a joindre
# qu'une adresse publique en http/https : voir OutboundUrlGuard.
DOLINEWS_LINK_CHECK_TIMEOUT=10
DOLINEWS_LINK_CHECK_MAX_BYTES=262144

# Flux generiques (SPEC 6.4) : cache borne et taille de page.
DOLINEWS_FEEDS_CACHE_SECONDS=300
DOLINEWS_FEEDS_PAGE_SIZE=50

# Verification de contribution : duree de validite du code (minutes), puis
# tentatives par heure. Demarrer le parcours envoie un courriel a une adresse
# de TIERS lue dans l'index public : l'endpoint est borne par compte et par
# origine.
DOLINEWS_VERIFY_CODE_TTL=60
DOLINEWS_VERIFY_ATTEMPTS_ACCOUNT=5
DOLINEWS_VERIFY_ATTEMPTS_IP=15

# ---------------------------------------------------------------------------
# Piege a scanners (~/docs/laravel/LARAVEL_HONEYPOT.md)
# ---------------------------------------------------------------------------

HONEYPOT_ENABLED=true
HONEYPOT_IP_WHITELIST=

# Frontal eventuel (vide = exposition directe). Lu par TrustProxies et par
# la garde du honeypot pour refuser de signaler le frontal lui-meme.
TRUSTED_PROXIES=

# Report Fail2Band (derriere un frontal). Desactive par defaut : sortie
# locale fail2ban en exposition directe.
HONEYPOT_FAIL2BAND_ENABLED=false
HONEYPOT_FAIL2BAND_URL=
HONEYPOT_FAIL2BAND_API_KEY=
HONEYPOT_FAIL2BAND_JAIL=dolinews-honeypot
HONEYPOT_FAIL2BAND_TIMEOUT=5

# ---------------------------------------------------------------------------
# Exploitation (caprel/laravel-ops, ~/docs/laravel/LARAVEL_DOCTOR.md)
# ---------------------------------------------------------------------------

# Destinataire du rapport d'audit des dépendances (`ops:security-audit`,
# planifié à 06:00). À défaut, l'adresse d'expédition de l'application est
# utilisée. Sans destinataire du tout, la commande échoue au lieu de se
# taire : un rapport qui ne part nulle part est pire que pas de rapport.
OPS_SECURITY_EMAIL=

# Topologie de l'ordonnanceur : `cron` (entrée /etc/cron.d, la nôtre) ou
# `supervisor` (programme schedule:work). Une seule des deux, jamais les
# deux : chaque tâche planifiée s'exécuterait en double.
OPS_SCHEDULER=cron
