# The project targets PHP 8.2 (S1), which is what the default CLI `php`
# provides on the build hosts. Override with `make PHP=php8.3` to run the
# gate against a newer interpreter.
PHP ?= php
PINT := $(PHP) vendor/bin/pint
PHPSTAN := $(PHP) vendor/bin/phpstan
PEST := $(PHP) vendor/bin/pest

.PHONY: lint lint-fix phpstan test ci

# Style check (no changes).
lint:
	$(PINT) --test

# Apply code style fixes.
lint-fix:
	$(PINT)

# Static analysis at level 8 (larastan).
phpstan:
	$(PHPSTAN) analyse --no-progress --memory-limit=1G

# Test suite (Pest).
test:
	$(PEST)

# Full CI gate: style, static analysis, tests.
ci: lint phpstan test
