# Rotation of the scheduler log, installed as /etc/logrotate.d/{{APP_SLUG}}-scheduler.
#
# This file is the versioned template: `php artisan install:logrotate` replaces
# the double-brace placeholders with the values of the current deployment and
# writes the result to /etc/logrotate.d/. Never hand-edit the generated file, a
# redeploy would overwrite it.
#
# storage/logs/cron.log is written by the shell cron starts every minute
# (deploy/cron/scheduler.cron), not by Laravel: nothing else ever truncates it,
# and a scheduler that fails to boot writes a stack trace per minute.
#
# No copytruncate here, unlike the honeypot log: cron reopens the file in append
# mode at every run, so the next minute recreates it after a plain rename. The
# owner must stay the account running the scheduler, else the first run after a
# rotation cannot open its own log and fails silently. That account is the owner
# of the application directory, which is what {{USER}} resolves to; pass
# --user/--group to install:logrotate when the log belongs to someone else.

{{LOG_DIR}}/cron.log {
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    create 0640 {{USER}} {{GROUP}}
}

# storage/logs/worker.log is deliberately absent from this file: Supervisor
# rotates it itself through stdout_logfile_maxbytes / stdout_logfile_backups in
# deploy/supervisor/worker.conf. Adding it here would have logrotate rename a
# file Supervisor keeps open, and the worker would go on writing into the
# rotated inode, where nobody looks.
